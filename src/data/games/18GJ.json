  "privates": [
    {
      "name": "Abraham Donaldson",
      "description": "Up to three times during the game, the president may augment train revenue, even if there is none, from the company treasury in $10 increments. Counts for stock movement. May add enough to double- or triple-jump; a triple-jump is allowed even below $165/share.",
      "note": "3 uses"
    },
    {
      "name": "Max Delaney",
      "description": "This company is not required to own a train."
    },
    {
      "name": "Lemuel Morrissey",
      "description": "The president may place a +$20 token on any city. Each train of this company that runs to it earns $20 more. It cannot be moved and is removed with the president."
    },
    {
      "name": "Logan Maynard",
      "description": "Up to three times during the game, the company may place or upgrade one additional tile as an extra action (can upgrade a just placed or upgraded tile). Terrain costs apply.",
      "note": "3 uses"
    },
    {
      "name": "Corbett Thompson",
      "description": "Up to two times during the game, the president may decide when the company operates, at the beginning of an Operating Round.",
      "note": "2 uses"
    },
    {
      "name": "Orrin Langhorne",
      "description": "A player may own up to 100% of this company, and is never obliged to sell down below the limit."
    },
    {
      "name": "Orville Gillis",
      "description": "Up to three times during the game, the company may ignore terrain costs when building track.",
      "note": "3 uses"
    },
    {
      "name": "Adolphus Meyer",
      "description": "Up to three times during the game, the company may claim a 10% discount on a single train from the bank. Up to three discounts may be combined (10%, 20% or 30%).",
      "note": "3 uses"
    },
    {
      "name": "Rufus Snape",
      "description": "Up to two times during the game, the company may place a station token for no cost.",
      "note": "2 uses"
    },
    {
      "name": "Arvid Bollen",
      "description": "Up to three times during the game, the president may prevent the company from losing stock value during an Operating Round.",
      "note": "3 uses"
    },
    {
      "name": "Brice Melville",
      "description": "The company may place a station token in a location even if it is full (not Grand Junction). It is placed near the other tokens; a reserved home token is placed in its reserved spot and the reserving company's token goes near the others."
    },
    {
      "name": "Neville Tinning",
      "description": "The company may either issue or redeem shares at the current market value."
    },
    {
      "name": "Hugo Weddell",
      "description": "Up to three times during the game, the trains of this company may score one additional station on a legal route (a 2 operates as a 3, a 4/6 as a 5/6).",
      "note": "3 uses"
    },
    {
      "name": "Abel Jephcots",
      "description": "One of the company's trains earns $10 per city visited (a 4/6 train serving 6 locations earns $60)."
    },
    {
      "name": "Walton Purcell",
      "description": "The company is paid $20 into its treasury by the bank in each operating round."
    },
    {
      "name": "Elias Bluit",
      "description": "Up to three times during the game, the company may upgrade any one tile to the next color, even if that color is not yet available. Part of the normal tile laying step.",
      "note": "3 uses"
    },
    {
      "name": "Cleveland Graham",
      "description": "The company may redeem shares of other companies from the open market. Dividends go to its treasury. It may issue them (even in Emergency Financing, with no price effect) and players may buy them from its treasury. Never president of another company; these shares do not count as held by players for issue limits."
    },
    {
      "name": "Homer Cropper",
      "description": "When the president's certificate is purchased, the company receives from the bank the sum of two 10% shares at the initial share value ($80 to $300)."
    }
  ],
