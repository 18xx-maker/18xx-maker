{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://18xx-maker.com/schemas/config.schema.json",

  "definitions": {
    "cardSize": {
      "type": "object",
      "description": "schema.config.cardSize",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "description": "schema.config.cardSize.width"
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "description": "schema.config.cardSize.height"
        }
      },
      "additionalProperties": false
    },
    "cardSizes": {
      "type": "object",
      "description": "schema.config.cardSizes",
      "properties": {
        "private": { "$ref": "#/definitions/cardSize" },
        "share": { "$ref": "#/definitions/cardSize" },
        "train": { "$ref": "#/definitions/cardSize" },
        "number": { "$ref": "#/definitions/cardSize" }
      },
      "additionalProperties": false
    },
    "dieCard": {
      "type": "object",
      "description": "schema.config.dieCard",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "description": "schema.config.cardSize.width"
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "description": "schema.config.cardSize.height"
        },
        "sizes": { "$ref": "#/definitions/cardSizes" }
      },
      "additionalProperties": false
    },
    "font": {
      "type": "object",
      "properties": {
        "size": { "type": "string" },
        "weight": { "type": "string", "enum": ["normal", "bold"] },
        "family": { "type": "string" }
      },
      "additionalProperties": { "$ref": "#/definitions/font" }
    },
    "dimension": {
      "type": "integer",
      "minimum": 1
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": { "$ref": "#/definitions/dimension" },
        "height": { "$ref": "#/definitions/dimension" }
      },
      "required": ["width", "height"]
    },
    "margins": {
      "$ref": "#/definitions/dimension"
    },
    "pins": {
      "type": "object",
      "properties": {
        "innerRadius": { "type": "number", "minimum": 0 },
        "outerRadius": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "x1": { "type": "number", "minimum": 0 },
        "x2": { "type": "number", "minimum": 0 }
      },
      "required": ["innerRadius", "outerRadius", "y", "x1", "x2"],
      "additionalProperties": false
    }
  },

  "type": "object",
  "properties": {
    "theme": { "type": "string" },
    "companiesTheme": { "type": "string" },
    "companyNames": {
      "type": "string",
      "enum": ["name", "alias", "both"],
      "description": "schema.config.companyNames"
    },
    "allowGameConfig": {
      "type": "boolean",
      "description": "schema.config.allowGameConfig"
    },
    "printScale": {
      "type": "number",
      "minimum": 50,
      "maximum": 200,
      "description": "schema.config.printScale"
    },
    "paper": {
      "allOf": [
        {
          "$ref": "#/definitions/dimensions"
        },
        {
          "type": "object",
          "properties": {
            "margins": { "$ref": "#/definitions/margins" }
          },
          "required": ["margins"]
        }
      ]
    },
    "currency": {
      "type": "object",
      "properties": {
        "bank": { "type": "boolean" },
        "border": { "type": "boolean" },
        "capital": { "type": "boolean" },
        "market": { "type": "boolean" },
        "offboard": { "type": "boolean" },
        "par": { "type": "boolean" },
        "private": { "type": "boolean" },
        "revenue": { "type": "boolean" },
        "share": { "type": "boolean" },
        "terrain": { "type": "boolean" },
        "token": { "type": "boolean" },
        "train": { "type": "boolean" },
        "treasury": { "type": "boolean" },
        "value": { "type": "boolean" }
      },
      "required": [
        "bank",
        "border",
        "capital",
        "market",
        "offboard",
        "par",
        "private",
        "revenue",
        "terrain",
        "token",
        "train",
        "value"
      ],
      "additionalProperties": false
    },
    "stock": {
      "type": "object",
      "properties": {
        "cell": { "$ref": "#/definitions/dimensions" },
        "value": { "type": "string", "enum": ["top", "bottom"] },
        "arrows": { "type": "string", "enum": ["top", "middle", "bottom"] },
        "column": { "type": "number" },
        "diag": { "type": "number" },
        "par": { "type": "number" },
        "display": {
          "type": "object",
          "properties": {
            "legend": { "type": "boolean" },
            "par": { "type": "boolean" },
            "roundTracker": { "type": "boolean" },
            "movement": { "type": "boolean" }
          },
          "required": ["legend", "par", "roundTracker", "movement"],
          "additionalProperties": false
        }
      },
      "required": ["cell", "value", "column", "diag", "par"],
      "additionalProperties": false
    },
    "cutlines": { "type": "number", "minimum": 0 },
    "cutlinesOffset": { "type": "number", "minimum": 0 },
    "bleed": { "type": "number", "minimum": 0 },
    "margin": { "type": "number", "minimum": 0 },
    "export": {
      "type": "object",
      "properties": {
        "allLayouts": { "type": "boolean" }
      }
    },
    "cards": {
      "type": "object",
      "properties": {
        "shareStyle": {
          "type": "string",
          "enum": ["center", "left", "gmt"]
        },
        "layout": {
          "type": "string",
          "enum": ["free", "miniEuroDie", "dtgDie"]
        },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "cutlines": { "type": "number", "minimum": 0 },
        "bleed": { "type": "number", "minimum": 0 },
        "dtgPadding": { "type": "number", "minimum": 0 },
        "padding": { "type": "number", "minimum": 0 },
        "border": { "type": "number", "minimum": 0 },
        "blackBand": { "type": "boolean" },
        "sizes": {
          "$ref": "#/definitions/cardSizes",
          "description": "schema.config.cards.sizes"
        },
        "dice": {
          "type": "object",
          "description": "schema.config.cards.dice",
          "properties": {
            "miniEuroDie": { "$ref": "#/definitions/dieCard" },
            "dtgDie": { "$ref": "#/definitions/dieCard" }
          },
          "additionalProperties": false
        },
        "showPins": {
          "type": "boolean",
          "description": "schema.config.cards.showPins"
        },
        "duplex": {
          "type": "string",
          "enum": ["off", "separate", "long"],
          "description": "schema.config.cards.duplex"
        },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": [
        "shareStyle",
        "layout",
        "width",
        "height",
        "cutlines",
        "bleed",
        "dtgPadding",
        "blackBand",
        "pins"
      ],
      "additionalProperties": false
    },
    "privates": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["small", "big"] }
      },
      "additionalProperties": false,
      "required": ["style"]
    },
    "trains": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["color", "number"] },
        "images": { "type": "boolean" }
      },
      "additionalProperties": false,
      "required": ["style", "images"]
    },
    "charters": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "enum": ["carth", "color"]
        },
        "layout": {
          "type": "string",
          "enum": ["free", "3x1", "3x2", "3x1minors"]
        },
        "cutlines": { "type": "number", "minimum": 0 },
        "bleed": { "type": "number", "minimum": 0 },
        "border": { "type": "number", "minimum": 0 },
        "halfWidth": { "type": "boolean" },
        "halfWidthMinors": { "type": "boolean" },
        "smallerMinors": { "type": "boolean" },
        "blackBand": { "type": "boolean" },
        "showPhaseChart": { "type": "boolean" },
        "showTurnOrder": { "type": "boolean" },
        "showMinorTurnOrder": { "type": "boolean" },
        "trainCards": { "type": "string", "enum": ["charter", "cards"] },
        "trainCardBorder": { "type": "boolean" },
        "trainCardRound": { "type": "boolean" },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": ["style", "halfWidth", "cutlines", "border", "blackBand"],
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["free", "gsp"]
        },
        "reverseMarketTokens": {
          "type": "string",
          "enum": ["none", "one", "all"]
        },
        "marketTokenSize": { "type": "number", "minimum": 1 },
        "stationTokenSize": { "type": "number", "minimum": 1 },
        "generalTokenSize": { "type": "number", "minimum": 1 },
        "bleed": { "type": "boolean" }
      },
      "additionalProperties": false,
      "required": ["layout", "marketTokenSize", "stationTokenSize", "bleed"]
    },
    "coords": {
      "type": "string",
      "enum": ["outside", "inside", "edge", "none"]
    },
    "tiles": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["right", "left", "none"]
        },
        "colorblind": { "type": "boolean" },
        "layout": {
          "type": "string",
          "enum": ["offset", "individual", "die", "smallDie"]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mapWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gaps": { "type": "boolean" },
        "cutBorder": {
          "type": "boolean",
          "description": "schema.config.tiles.cutBorder"
        },
        "showPins": {
          "type": "boolean",
          "description": "schema.config.cards.showPins"
        },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": ["layout", "width", "mapWidth", "gaps"],
      "additionalProperties": false
    },
    "companySvgLogos": {
      "type": "string",
      "enum": ["none", "original", "match", "main"]
    },
    "overrideCompanies": {
      "type": "string",
      "enum": [
        "none",
        "languages",
        "lotr",
        "dev",
        "webdev",
        "owl",
        "1830",
        "1830-Mayfair"
      ]
    },
    "overrideSelection": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "maps": {
      "type": "object",
      "required": ["market", "players", "roundTracker", "movement"],
      "additionalProperties": false,
      "properties": {
        "market": { "type": "boolean" },
        "players": { "type": "boolean" },
        "roundTracker": { "type": "boolean" },
        "movement": { "type": "boolean" }
      }
    },
    "plainMapCompanies": { "type": "boolean" },
    "tileCompanies": { "type": "boolean" },
    "straightCityNames": { "type": "boolean" },
    "font": { "$ref": "#/definitions/font" }
  },
  "required": [
    "bleed",
    "companiesTheme",
    "companyNames",
    "companySvgLogos",
    "coords",
    "cutlines",
    "cutlinesOffset",
    "font",
    "margin",
    "overrideCompanies",
    "overrideSelection",
    "paper",
    "plainMapCompanies",
    "stock",
    "theme",
    "tileCompanies",
    "tokens"
  ],
  "additionalProperties": false
}
