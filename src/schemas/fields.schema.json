{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://18xx-maker.com/schemas/fields.schema.json",
  "definitions": {
    "order": {
      "type": "object",
      "properties": {
        "order": {
          "description": "schema.fields.order.order",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean",
              "enum": [true]
            }
          ]
        }
      }
    },
    "text": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "textColor": {
          "type": "string"
        },
        "textBorderWidth": {
          "type": "number",
          "minimum": 0
        },
        "textBorderColor": {
          "type": "string"
        }
      }
    },
    "font": {
      "type": "object",
      "properties": {
        "fontStyle": {
          "type": "string",
          "enum": ["normal", "italic", "oblique"]
        },
        "fontWeight": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["normal", "bold", "bolder", "lighter"]
            },
            {
              "type": "number"
            }
          ]
        },
        "fontFamily": {
          "type": "string"
        },
        "fontSize": {
          "type": "integer",
          "minimum": 4
        }
      }
    },
    "svg": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "borderColor": {
          "type": "string"
        },
        "borderWidth": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "dashed": {
          "type": "boolean",
          "enum": [true]
        }
      }
    },
    "revenue": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "position": {
      "type": "object",
      "properties": {
        "hidden": {
          "description": "schema.fields.position.hidden",
          "type": "boolean",
          "enum": [true]
        },
        "angle": {
          "description": "schema.fields.position.angle",
          "type": "number",
          "exclusiveMinimum": -360,
          "exclusiveMaximum": 360
        },
        "rotate": {
          "description": "schema.fields.position.rotate",
          "type": "number",
          "exclusiveMinimum": -360,
          "exclusiveMaximum": 360
        },
        "rotation": {
          "description": "schema.fields.position.rotation",
          "type": "number",
          "exclusiveMinimum": -360,
          "exclusiveMaximum": 360
        },
        "side": {
          "description": "schema.fields.position.side",
          "type": "number",
          "minimum": 1,
          "maximum": 6
        },
        "mid": {
          "description": "schema.fields.position.mid",
          "type": "string",
          "enum": ["gentle", "sharp", "straight"]
        },
        "align": {
          "description": "schema.fields.position.align",
          "type": "string",
          "enum": ["perpendicular", "parallel"]
        },
        "x": {
          "description": "schema.fields.position.x",
          "type": "number"
        },
        "y": {
          "description": "schema.fields.position.y",
          "type": "number"
        },
        "percent": {
          "description": "schema.fields.position.percent",
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
