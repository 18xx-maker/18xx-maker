{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://18xx-maker.com/schemas/fields.schema.json",

  "definitions": {
    "order": {
      "type": "object",
      "properties": {
        "order": {
          "description": "Draw order. An element with order is drawn after all elements of its kind that have none, lowest value first, so it can sit on top of things it normally sits under (a city over a value). A negative number draws it before all of them, and true draws it last. Its position does not change, only when it is drawn.",
          "oneOf": [{ "type": "number" }, { "type": "boolean", "enum": [true] }]
        }
      }
    },
    "text": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "textColor": { "type": "string" },
        "textBorderWidth": { "type": "number", "minimum": 0 },
        "textBorderColor": { "type": "string" }
      }
    },

    "font": {
      "type": "object",
      "properties": {
        "fontStyle": {
          "type": "string",
          "enum": ["normal", "italic", "oblique"]
        },
        "fontWeight": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["normal", "bold", "bolder", "lighter"]
            },
            { "type": "number" }
          ]
        },
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "integer", "minimum": 4 }
      }
    },

    "svg": {
      "type": "object",
      "properties": {
        "color": { "type": "string" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },

        "borderColor": { "type": "string" },
        "borderWidth": { "type": "number", "minimum": 0 },

        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },

        "dashed": { "type": "boolean", "enum": [true] }
      }
    },

    "revenue": {
      "type": "object",
      "properties": {
        "groups": { "type": "array", "items": { "type": "string" } }
      }
    },

    "position": {
      "type": "object",
      "properties": {
        "hidden": { "type": "boolean", "enum": [true] },
        "angle": {
          "type": "number",
          "exclusiveMinimum": -360,
          "exclusiveMaximum": 360
        },
        "rotate": {
          "type": "number",
          "exclusiveMinimum": -360,
          "exclusiveMaximum": 360
        },
        "rotation": {
          "type": "number",
          "exclusiveMinimum": -360,
          "exclusiveMaximum": 360
        },
        "side": { "type": "number", "minimum": 1, "maximum": 6 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "percent": { "type": "number", "minimum": 0 }
      }
    }
  }
}
