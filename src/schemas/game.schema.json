{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://18xx-maker.com/schemas/game.schema.json",
  "definitions": {
    "numberOrSlash": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[0-9]+ ?/ ?[0-9]+( ?/ ?[0-9]+)*$"
        },
        {
          "type": "string",
          "pattern": "^∞$"
        }
      ]
    },
    "bank": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^∞$"
        }
      ]
    },
    "capital": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string"
        }
      ]
    },
    "certLimit": {
      "$ref": "#/definitions/numberOrSlash"
    },
    "link": {
      "type": "string",
      "pattern": "(mailto|https?):.*"
    },
    "map": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "copy": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "boolean",
          "const": false
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+[0-9]+$"
          }
        },
        "hexes": {
          "type": "array",
          "items": {
            "$ref": "tiles.defs.json#/definitions/hex"
          }
        },
        "roundTracker": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "rotation": {
              "type": "number",
              "exclusiveMinimum": -360,
              "exclusiveMaximum": 360
            },
            "type": {
              "type": "string",
              "enum": ["row", "row-reverse", "col", "col-reverse", "round"]
            }
          },
          "additionalProperties": false
        },
        "market": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "players": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "cellWidth": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "borderTexts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cost": {
                "type": "number"
              },
              "circle": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "bgColor": {
                "type": "string"
              },
              "coord": {
                "type": "string",
                "pattern": "^[A-Z]+[0-9]+(s[1-6])|(p[1-6])|(a[0-9]+p[0-9]+)|(x[0-9]+y[0-9]+)"
              }
            }
          }
        },
        "borders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string"
              },
              "coords": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]+[0-9]+(s[1-6])|(p[1-6])|(a[0-9]+p[0-9]+)|(x[0-9]+y[0-9]+)"
                }
              }
            }
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string"
              },
              "coords": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]+[0-9]+(s[1-6])|(p[1-6])|(a[0-9]+p[0-9]+)|(x[0-9]+y[0-9]+)"
                }
              }
            }
          }
        }
      },
      "required": ["hexes"],
      "additionalProperties": false
    },
    "trainItem": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string"
            },
            "index": {
              "type": "integer",
              "minimum": 2
            }
          }
        }
      ]
    },
    "train": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "price": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "color": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "phase": {
          "type": "boolean"
        },
        "quantity": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "enum": ["∞"]
            }
          ]
        },
        "quantity_label": {
          "type": "string"
        },
        "print": {
          "type": "integer",
          "minimum": 0
        },
        "discount": {
          "type": "object"
        },
        "upgrade": {
          "description": "Cost of this train when bought as an upgrade, shown under the price",
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "tradeIn": {
          "description": "Value of this train when traded in, shown in parentheses under the price",
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "available": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "rust": {
          "$ref": "#/definitions/trainEvent"
        },
        "phased": {
          "$ref": "#/definitions/trainEvent"
        },
        "obsolete": {
          "$ref": "#/definitions/trainEvent"
        },
        "permanent": {
          "type": "boolean"
        },
        "players": {
          "type": "integer"
        }
      },
      "required": ["name", "color"],
      "additionalProperties": false
    },
    "companyTrain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        {
          "$ref": "#/definitions/train"
        }
      ]
    },
    "trainEvent": {
      "oneOf": [
        {
          "$ref": "#/definitions/trainItem"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/trainItem"
          }
        }
      ]
    },
    "shares": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "label": {
            "type": "string"
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "percent": {
            "$ref": "#/definitions/numberOrSlash"
          },
          "revenue": {
            "$ref": "#/definitions/numberOrSlash"
          },
          "shares": {
            "$ref": "#/definitions/numberOrSlash"
          },
          "variant": {
            "type": "string"
          }
        },
        "required": ["quantity"]
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "$ref": "#/definitions/charterToken"
          }
        ]
      }
    },
    "charterToken": {
      "type": "object",
      "description": "A token space on a charter, with more than a cost.",
      "properties": {
        "cost": {
          "description": "The label under the token space, like the plain string or number entry.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "start": {
          "type": "boolean",
          "description": "The company starts with a token in this space. Color charters show the logo in it instead of an empty circle, carth charters show an empty circle instead of the logo. false is the same as leaving it out."
        }
      },
      "additionalProperties": false
    },
    "token": {
      "$ref": "tiles.defs.json#/definitions/token"
    },
    "gameTokens": {
      "type": "array",
      "description": "The tokens of the game that print on the token sheet. A string or a number is a white token with that label.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "$ref": "tiles.defs.json#/definitions/gameToken"
          }
        ]
      }
    },
    "cellObject": {
      "type": "object",
      "description": "A cell of the stock market, par chart or revenue chart.",
      "properties": {
        "value": {
          "description": "The price shown in the cell, formatted with the market currency.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "label": {
          "description": "Text shown instead of a value.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "subLabel": {
          "description": "A second text, at the opposite corner of the cell.",
          "type": "string"
        },
        "color": {
          "description": "Background color of the cell.",
          "type": "string"
        },
        "labelColor": {
          "description": "Color of the texts, defaults to a readable color.",
          "type": "string"
        },
        "arrow": {
          "description": "The arrow or arrows drawn in the corners of the cell.",
          "oneOf": [
            {
              "type": "string",
              "enum": ["up", "down", "left", "right"]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["up", "down", "left", "right"]
              }
            }
          ]
        },
        "arrowColor": {
          "description": "Color of the arrows.",
          "type": "string"
        },
        "legend": {
          "description": "Index in the stock legend, the cell takes the color of that legend entry.",
          "type": "integer",
          "minimum": 0
        },
        "par": {
          "description": "The cell is a par value, it takes the color of the par chart.",
          "type": "boolean"
        },
        "bottom": {
          "description": "Draw the cell below the other cells.",
          "type": "boolean"
        },
        "underline": {
          "description": "Underline the text of the cell.",
          "type": "boolean"
        },
        "rotated": {
          "description": "Rotate the label.",
          "type": "boolean"
        },
        "subRotated": {
          "description": "Rotate the sub label.",
          "type": "boolean"
        },
        "width": {
          "description": "Width of the cell, in cells.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "description": "Height of the cell, in cells.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "companies": {
          "description": "Companies shown as bars in the cell: an abbreviation, or an abbreviation with the row of the bar.",
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "abbrev": {
                    "type": "string"
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": ["abbrev"],
                "additionalProperties": false
              }
            ]
          }
        },
        "tokens": {
          "description": "Tokens drawn in the cell. A company is a company token, otherwise a token with x and y positions.",
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "cell": {
      "description": "A cell of a market: nothing, a price, a label or an object.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/cellObject"
        }
      ]
    },
    "cellRows": {
      "type": "array",
      "description": "Rows of cells, or a single cell for a row of one.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/cell"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/definitions/cell"
            }
          }
        ]
      }
    },
    "roundTracker": {
      "type": "object",
      "description": "Where to draw the round tracker, in cells of the market.",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "rotation": {
          "type": "number",
          "exclusiveMinimum": -360,
          "exclusiveMaximum": 360
        },
        "type": {
          "type": "string",
          "enum": ["row", "row-reverse", "col", "col-reverse", "round"]
        }
      },
      "additionalProperties": false
    },
    "stock": {
      "type": "object",
      "description": "The stock market, and the par and revenue charts.",
      "properties": {
        "type": {
          "description": "The layout of the market: 2D is a grid, 1D a single row, 1Diag a zigzag row. Defaults to 2D.",
          "type": "string",
          "enum": ["1D", "2D", "1Diag"]
        },
        "title": {
          "description": "false hides the title above the market.",
          "type": "boolean",
          "const": false
        },
        "market": {
          "description": "The cells: rows of cells for a 2D market, a row of cells for the others.",
          "$ref": "#/definitions/cellRows"
        },
        "par": {
          "description": "The par chart.",
          "type": "object",
          "properties": {
            "values": {
              "description": "The par values, rows of cells.",
              "$ref": "#/definitions/cellRows"
            },
            "color": {
              "description": "Background color of the par cells.",
              "type": "string"
            },
            "width": {
              "description": "Width of a par cell, in cells.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "description": "Height of a par cell, in cells.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "title": {
              "description": "false hides the title above the par chart.",
              "type": "boolean",
              "const": false
            }
          },
          "additionalProperties": false
        },
        "cell": {
          "description": "The size and color every market cell starts with.",
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "display": {
          "description": "Where the parts of the market are drawn.",
          "type": "object",
          "properties": {
            "par": {
              "description": "Draw the par chart on the market, at x and y cells from the corner.",
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            },
            "legend": {
              "description": "Where the legend goes on a 2D market, or a 1Diag market.",
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "reverse": {
                  "type": "boolean"
                },
                "align": {
                  "type": "string",
                  "enum": ["left", "right"]
                },
                "verticalAlign": {
                  "type": "string",
                  "enum": ["top", "bottom"]
                }
              },
              "additionalProperties": false
            },
            "roundTracker": {
              "$ref": "#/definitions/roundTracker"
            },
            "extraTotalHeight": {
              "description": "Extra height of the page, in units.",
              "type": "number"
            },
            "extraTotalWidth": {
              "description": "Extra width of the page, in units.",
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "ledges": {
          "description": "Lines drawn over the market, from corner to corner of cells.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "coords": {
                "description": "The corners of the line, each as the x and y of a cell corner, like 6 0.",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^-?[0-9]+ -?[0-9]+$"
                },
                "minItems": 2
              },
              "color": {
                "type": "string"
              },
              "width": {
                "type": "number"
              },
              "border": {
                "description": "Draw a border around the line.",
                "type": "boolean"
              },
              "borderWidth": {
                "type": "number"
              },
              "dashed": {
                "description": "Draw a dashed line.",
                "type": "boolean"
              },
              "dashArray": {
                "type": "number"
              },
              "offset": {
                "description": "Offset of the dashes.",
                "type": "number"
              }
            },
            "required": ["coords"],
            "additionalProperties": false
          }
        },
        "legend": {
          "description": "The legend of the colors of the market.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "borderColor": {
                "type": "string"
              },
              "borderWidth": {
                "type": "number"
              },
              "fontFamily": {
                "type": "string"
              },
              "fontSize": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "fontWeight": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "icon": {
                "description": "Not drawn at the moment.",
                "type": "string"
              }
            },
            "required": ["description"],
            "additionalProperties": false
          }
        },
        "movement": {
          "description": "How the share price moves, by direction. Kept for reference, it is not printed.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "limits": {
          "description": "Ranges of share prices, like the allowed par values. Kept for reference, it is not printed.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "colorValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/colorValue"
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "info": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "designer": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "extraTotalHeight": {
          "type": "number",
          "minimum": 1
        },
        "extraTotalWidth": {
          "type": "number",
          "minimum": 1
        },
        "titleX": {
          "type": "number"
        },
        "titleY": {
          "type": "number"
        },
        "titleRotate": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "titleSize": {
          "type": "number"
        },
        "subtitleSize": {
          "type": "number"
        },
        "designerSize": {
          "type": "number"
        },
        "titleFontFamily": {
          "type": "string"
        },
        "subtitleFontFamily": {
          "type": "string"
        },
        "designerFontFamily": {
          "type": "string"
        },
        "orientation": {
          "type": "string",
          "enum": ["horizontal", "vertical"]
        },
        "capitalization": {
          "type": "string",
          "enum": ["full", "incremental"]
        },
        "mustSellInBlocks": {
          "type": "boolean"
        },
        "marketTokens": {
          "type": "integer",
          "minimum": 0
        },
        "extraStationTokens": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "description": "The currency format string must contain a # character",
          "type": "string",
          "pattern": "^(.*)#(.*)$"
        }
      },
      "required": ["title"],
      "additionalProperties": false
    },
    "colors": {
      "type": "object",
      "description": "Colors of the game by name. A color is a CSS color or another color name, or an object of those by phase.",
      "additionalProperties": {
        "$ref": "#/definitions/colorValue"
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "bgg": {
          "$ref": "#/definitions/link"
        },
        "license": {
          "$ref": "#/definitions/link"
        },
        "purchase": {
          "$ref": "#/definitions/link"
        },
        "rules": {
          "$ref": "#/definitions/link"
        }
      },
      "additionalProperties": false
    },
    "bank": {
      "$ref": "#/definitions/bank"
    },
    "capital": {
      "$ref": "#/definitions/capital"
    },
    "certLimit": {
      "$ref": "#/definitions/certLimit"
    },
    "floatPercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "tokenTypes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/tokens"
      }
    },
    "number_cards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shareTypes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/shares"
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "abbrev"],
        "properties": {
          "name": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "shares": {
            "oneOf": [
              {
                "$ref": "#/definitions/shares"
              },
              {
                "type": "string"
              }
            ]
          },
          "tokens": {
            "oneOf": [
              {
                "$ref": "#/definitions/tokens"
              },
              {
                "type": "string"
              }
            ]
          },
          "tokensBelow": {
            "type": "boolean",
            "description": "Print the token slots of the charter in their own row under the company name, smaller so they fit the width, instead of to the right of the name. Use it for companies with many tokens, so they do not squeeze the name. Half width charters ignore it. Defaults to false."
          },
          "loans": {
            "type": "array",
            "description": "Loan slots printed on the charter as empty squares in the body of the charter, on the right below the header, in columns that fit the height of the charter (more loans than fit are cut off). Each entry is the label under the slot (a string or a number); an empty string or null leaves the slot without a label.",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "trains": {
            "description": "false hides the trains label on the charter. Otherwise the trains the company owns: the name of a game train, { name, quantity } for several copies of a game train, or a full train (quantity defaults to 1). They print on the charter, or as train cards when the charters trainCards config is cards.",
            "oneOf": [
              {
                "const": false
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/companyTrain"
                }
              }
            ]
          },
          "token": {
            "$ref": "#/definitions/token"
          }
        }
      }
    },
    "map": {
      "oneOf": [
        {
          "$ref": "#/definitions/map"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/map"
          }
        }
      ]
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "minor": {
            "type": "boolean"
          },
          "company": {
            "type": "string"
          },
          "train": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "limit": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^∞$"
              },
              {
                "type": "string",
                "pattern": "^[0-9]/[0-9]$"
              }
            ]
          },
          "rounds": {
            "type": "integer",
            "minimum": 1
          },
          "tiles": {
            "type": "string"
          },
          "on": {
            "$ref": "#/definitions/trainEvent"
          },
          "notes": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "buy_companies": {
            "type": "boolean"
          },
          "events": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "anyOf": [
          {
            "required": ["name", "limit", "tiles"]
          },
          {
            "required": ["train", "limit", "tiles"]
          }
        ],
        "additionalProperties": false
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bank": {
            "$ref": "#/definitions/bank"
          },
          "capital": {
            "$ref": "#/definitions/capital"
          },
          "certLimit": {
            "$ref": "#/definitions/certLimit"
          },
          "number": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": ["number"]
      }
    },
    "pools": {
      "type": "array",
      "description": "Notes about the pools of the game. Kept for reference, they are not printed.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "note": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                }
              },
              "required": ["note"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "privates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "minPlayers": {
            "type": "integer",
            "minimum": 1
          },
          "maxPlayers": {
            "type": "integer",
            "minimum": 1
          },
          "nameFontSize": {
            "type": "integer",
            "minimum": 1
          },
          "descFontSize": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "hex": {
            "type": "string"
          },
          "token": {
            "$ref": "#/definitions/token"
          },
          "company": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "iconColor": {
            "type": "string"
          },
          "tile": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "idBackgroundColor": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "sym": {
            "type": "string"
          },
          "abilities": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "An ability of the private. Kept for reference, it is not printed.",
              "properties": {
                "type": {
                  "type": "string"
                }
              },
              "required": ["type"]
            }
          },
          "bid": {
            "type": "number",
            "minimum": 0
          },
          "price": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string"
              }
            ]
          },
          "debt": {
            "type": "number",
            "minimum": 0
          },
          "revenue": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              {
                "type": "string",
                "pattern": "^.?.?[0-9].?%? ?/ ?.?.?[0-9].?%?$"
              }
            ]
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "rounds": {
      "type": "array",
      "description": "The rounds of the game, in order, for the round tracker.",
      "items": {
        "$ref": "tiles.defs.json#/definitions/roundToken"
      }
    },
    "stock": {
      "$ref": "#/definitions/stock"
    },
    "tiles": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "$ref": "tiles.defs.json#/definitions/hex"
          }
        ]
      }
    },
    "tokens": {
      "$ref": "#/definitions/gameTokens"
    },
    "turns": {
      "type": "array",
      "description": "The turns of the game, printed on the charter.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ordered": {
            "description": "Number the steps.",
            "type": "boolean"
          },
          "optional": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "trains": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/train"
          },
          {
            "required": ["quantity"]
          }
        ]
      }
    },
    "upgrades": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "wip": {
      "type": "boolean"
    },
    "prototype": {
      "type": "boolean"
    },
    "exports": {
      "type": "object",
      "description": "The options of an export (maker export, and the export options of the app) for this game. They are the defaults of the game: the flags of maker export, the user's config and the choices made in the export options panel come on top of them.",
      "properties": {
        "formats": {
          "type": "array",
          "description": "The files to export, like --format. pdf, png and b18 (a Board18 box). Defaults to pdf.",
          "items": {
            "type": "string",
            "enum": ["pdf", "png", "b18"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "docs": {
          "type": "array",
          "description": "Only export these pages, like --docs. All pages when left out. Only for pdf and png files.",
          "items": {
            "type": "string",
            "enum": [
              "background",
              "cards",
              "charters",
              "map",
              "market",
              "par",
              "revenue",
              "tile-manifest",
              "tiles",
              "tokens"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "layouts": {
          "type": "string",
          "description": "all exports a file for every layout of the cards, tiles and tokens, current only the layout of the config, like --layouts. When left out the export.allLayouts setting of the config decides.",
          "enum": ["all", "current"]
        },
        "paginated": {
          "type": "boolean",
          "description": "Deprecated and ignored. The paginated pdfs of the map, market, par and revenue are always exported when the page does not fit on one page of the paper."
        },
        "background": {
          "type": "string",
          "description": "The background of the map, market, par, revenue and tile manifest png images, like --background: white or transparent. Every other png image (the background page, cards, charters, tokens and tiles) is always transparent. Board18 boxes and pdf files are not affected: the map and market of a Board18 box are always white, its tokens and tiles transparent. Defaults to white.",
          "enum": ["white", "transparent"],
          "default": "white"
        },
        "variation": {
          "type": "integer",
          "description": "Only export this map variation (0 is the first), like --variation. All variations when left out.",
          "minimum": 0
        },
        "png": {
          "type": "object",
          "description": "Options of the png images.",
          "properties": {
            "dpi": {
              "type": "integer",
              "description": "The resolution of the images in dots per inch, like --dpi. 300 is the size they print at and the highest resolution. Defaults to 300.",
              "minimum": 1,
              "maximum": 300
            }
          },
          "additionalProperties": false
        },
        "b18": {
          "type": "object",
          "description": "Options of the Board18 box.",
          "properties": {
            "version": {
              "type": "string",
              "description": "The version of the box, like --b18-version. Defaults to 1.0.",
              "minLength": 1
            },
            "author": {
              "type": "string",
              "description": "The author of the box, like --b18-author. Defaults to the b18.author setting of maker config, the designer of the game in the app, or the name of the user.",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "revenue": {
      "type": "object",
      "description": "The range of the revenue chart.",
      "properties": {
        "min": {
          "description": "The first revenue, 1 by default.",
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "description": "The last revenue, 100 by default.",
          "type": "integer",
          "minimum": 1
        },
        "perRow": {
          "description": "How many revenues in a row, 20 by default.",
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": ["info"]
}
