{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://18xx-maker.com/schemas/config.schema.json",

  "definitions": {
    "cardSize": {
      "type": "object",
      "description": "The size of one type of card in units. A missing width or height uses cards.width or cards.height.",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "description": "The card width in units."
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "description": "The card height in units."
        }
      },
      "additionalProperties": false
    },
    "cardSizes": {
      "type": "object",
      "description": "Optional size per type of card, used instead of width and height. A missing width or height uses the one above.",
      "properties": {
        "private": { "$ref": "#/definitions/cardSize" },
        "share": { "$ref": "#/definitions/cardSize" },
        "train": { "$ref": "#/definitions/cardSize" },
        "number": { "$ref": "#/definitions/cardSize" }
      },
      "additionalProperties": false
    },
    "dieCard": {
      "type": "object",
      "description": "The size of the cards of a die layout in units. The paper, margins, cutlines and bleed of a die layout are fixed.",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "description": "The card width in units."
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "description": "The card height in units."
        },
        "sizes": { "$ref": "#/definitions/cardSizes" }
      },
      "additionalProperties": false
    },
    "font": {
      "type": "object",
      "properties": {
        "size": { "type": "string" },
        "weight": { "type": "string", "enum": ["normal", "bold"] },
        "family": { "type": "string" }
      },
      "additionalProperties": { "$ref": "#/definitions/font" }
    },
    "dimension": {
      "type": "integer",
      "minimum": 1
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": { "$ref": "#/definitions/dimension" },
        "height": { "$ref": "#/definitions/dimension" }
      },
      "required": ["width", "height"]
    },
    "margins": {
      "$ref": "#/definitions/dimension"
    },
    "pins": {
      "type": "object",
      "properties": {
        "innerRadius": { "type": "number", "minimum": 0 },
        "outerRadius": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "x1": { "type": "number", "minimum": 0 },
        "x2": { "type": "number", "minimum": 0 }
      },
      "required": ["innerRadius", "outerRadius", "y", "x1", "x2"],
      "additionalProperties": false
    }
  },

  "type": "object",
  "properties": {
    "theme": { "type": "string" },
    "companiesTheme": { "type": "string" },
    "companyNames": {
      "type": "string",
      "enum": ["name", "alias", "both"],
      "description": "What the charters and share cards print as the name of a company. name is the name, alias is the alias of the company (the name when it has none), both is the name with the alias under it."
    },
    "allowGameConfig": {
      "type": "boolean",
      "description": "Lets a game file change the config. When on, the config of the game (the config key of a game file) is applied on top of your settings, the URL and the app defaults. When off, it is ignored. Games cannot set this setting. Exports and the command line use it the same way."
    },
    "printScale": {
      "type": "number",
      "minimum": 50,
      "maximum": 200,
      "description": "Scales everything that prints, in percent, to correct for a printer that prints too big or too small. 100 is the real size. Paper size and margins stay the same, so the content of a page changes. It is a setting of the user, a game file cannot set it, and exports ignore it."
    },
    "paper": {
      "allOf": [
        {
          "$ref": "#/definitions/dimensions"
        },
        {
          "type": "object",
          "properties": {
            "margins": { "$ref": "#/definitions/margins" }
          },
          "required": ["margins"]
        }
      ]
    },
    "currency": {
      "type": "object",
      "properties": {
        "bank": { "type": "boolean" },
        "border": { "type": "boolean" },
        "capital": { "type": "boolean" },
        "market": { "type": "boolean" },
        "offboard": { "type": "boolean" },
        "par": { "type": "boolean" },
        "private": { "type": "boolean" },
        "revenue": { "type": "boolean" },
        "share": { "type": "boolean" },
        "terrain": { "type": "boolean" },
        "token": { "type": "boolean" },
        "train": { "type": "boolean" },
        "treasury": { "type": "boolean" },
        "value": { "type": "boolean" }
      },
      "required": [
        "bank",
        "border",
        "capital",
        "market",
        "offboard",
        "par",
        "private",
        "revenue",
        "terrain",
        "token",
        "train",
        "value"
      ],
      "additionalProperties": false
    },
    "stock": {
      "type": "object",
      "properties": {
        "cell": { "$ref": "#/definitions/dimensions" },
        "value": { "type": "string", "enum": ["top", "bottom"] },
        "arrows": { "type": "string", "enum": ["top", "middle", "bottom"] },
        "column": { "type": "number" },
        "diag": { "type": "number" },
        "par": { "type": "number" },
        "display": {
          "type": "object",
          "properties": {
            "legend": { "type": "boolean" },
            "par": { "type": "boolean" },
            "roundTracker": { "type": "boolean" },
            "movement": { "type": "boolean" }
          },
          "required": ["legend", "par", "roundTracker", "movement"],
          "additionalProperties": false
        }
      },
      "required": ["cell", "value", "column", "diag", "par"],
      "additionalProperties": false
    },
    "cutlines": { "type": "number", "minimum": 0 },
    "cutlinesOffset": { "type": "number", "minimum": 0 },
    "bleed": { "type": "number", "minimum": 0 },
    "margin": { "type": "number", "minimum": 0 },
    "export": {
      "type": "object",
      "properties": {
        "allLayouts": { "type": "boolean" }
      }
    },
    "cards": {
      "type": "object",
      "properties": {
        "shareStyle": {
          "type": "string",
          "enum": ["center", "left", "gmt"]
        },
        "layout": {
          "type": "string",
          "enum": ["free", "miniEuroDie", "dtgDie"]
        },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "cutlines": { "type": "number", "minimum": 0 },
        "bleed": { "type": "number", "minimum": 0 },
        "dtgPadding": { "type": "number", "minimum": 0 },
        "padding": { "type": "number", "minimum": 0 },
        "border": { "type": "number", "minimum": 0 },
        "blackBand": { "type": "boolean" },
        "sizes": {
          "$ref": "#/definitions/cardSizes",
          "description": "Optional size per type of card, used instead of width and height. A missing width or height uses the one above. Ignored by the die layouts, which use the sizes of cards.dice."
        },
        "dice": {
          "type": "object",
          "description": "The card sizes of the die layouts, which ignore width, height and sizes above.",
          "properties": {
            "miniEuroDie": { "$ref": "#/definitions/dieCard" },
            "dtgDie": { "$ref": "#/definitions/dieCard" }
          },
          "additionalProperties": false
        },
        "showPins": {
          "type": "boolean",
          "description": "Draw the pin markers on free layouts too. Fixed layouts (die layouts) always draw them. Free layouts reserve no space for pins, so adjust the pins positions or margins to keep them clear of content."
        },
        "duplex": {
          "type": "string",
          "enum": ["off", "separate", "long"],
          "description": "Print the backs of train cards. off prints no backs, separate prints all the fronts and then all the backs in the same order (for flipping the sheets by hand), long prints a sheet of backs after every sheet of fronts, mirrored for a printer set to flip on the long edge. Needs the free cards layout, the die layouts ignore it."
        },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": [
        "shareStyle",
        "layout",
        "width",
        "height",
        "cutlines",
        "bleed",
        "dtgPadding",
        "blackBand",
        "pins"
      ],
      "additionalProperties": false
    },
    "privates": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["small", "big"] }
      },
      "additionalProperties": false,
      "required": ["style"]
    },
    "trains": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["color", "number"] },
        "images": { "type": "boolean" }
      },
      "additionalProperties": false,
      "required": ["style", "images"]
    },
    "charters": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "enum": ["carth", "color"]
        },
        "layout": {
          "type": "string",
          "enum": ["free", "3x1", "3x2", "3x1minors"]
        },
        "cutlines": { "type": "number", "minimum": 0 },
        "bleed": { "type": "number", "minimum": 0 },
        "border": { "type": "number", "minimum": 0 },
        "halfWidth": { "type": "boolean" },
        "halfWidthMinors": { "type": "boolean" },
        "smallerMinors": { "type": "boolean" },
        "blackBand": { "type": "boolean" },
        "showPhaseChart": { "type": "boolean" },
        "showTurnOrder": { "type": "boolean" },
        "showMinorTurnOrder": { "type": "boolean" },
        "trainCards": { "type": "string", "enum": ["charter", "cards"] },
        "trainCardBorder": { "type": "boolean" },
        "trainCardRound": { "type": "boolean" },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": ["style", "halfWidth", "cutlines", "border", "blackBand"],
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["free", "gsp"]
        },
        "reverseMarketTokens": {
          "type": "string",
          "enum": ["none", "one", "all"]
        },
        "marketTokenSize": { "type": "number", "minimum": 1 },
        "stationTokenSize": { "type": "number", "minimum": 1 },
        "generalTokenSize": { "type": "number", "minimum": 1 },
        "bleed": { "type": "boolean" }
      },
      "additionalProperties": false,
      "required": ["layout", "marketTokenSize", "stationTokenSize", "bleed"]
    },
    "coords": {
      "type": "string",
      "enum": ["outside", "inside", "edge", "none"]
    },
    "tiles": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["right", "left", "none"]
        },
        "colorblind": { "type": "boolean" },
        "layout": {
          "type": "string",
          "enum": ["offset", "individual", "die", "smallDie"]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mapWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gaps": { "type": "boolean" },
        "cutBorder": {
          "type": "boolean",
          "description": "Draw a thin black outline at the exact cut size around every tile on the tile sheet, so tiles can be cut out by hand."
        },
        "showPins": {
          "type": "boolean",
          "description": "Draw the pin markers on free layouts too. Fixed layouts (die layouts) always draw them. Free layouts reserve no space for pins, so adjust the pins positions or margins to keep them clear of content."
        },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": ["layout", "width", "mapWidth", "gaps"],
      "additionalProperties": false
    },
    "companySvgLogos": {
      "type": "string",
      "enum": ["none", "original", "match", "main"]
    },
    "overrideCompanies": {
      "type": "string",
      "enum": [
        "none",
        "languages",
        "lotr",
        "dev",
        "webdev",
        "owl",
        "1830",
        "1830-Mayfair"
      ]
    },
    "overrideSelection": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "maps": {
      "type": "object",
      "required": ["market", "players", "roundTracker", "movement"],
      "additionalProperties": false,
      "properties": {
        "market": { "type": "boolean" },
        "players": { "type": "boolean" },
        "roundTracker": { "type": "boolean" },
        "movement": { "type": "boolean" }
      }
    },
    "plainMapCompanies": { "type": "boolean" },
    "tileCompanies": { "type": "boolean" },
    "straightCityNames": { "type": "boolean" },
    "font": { "$ref": "#/definitions/font" }
  },
  "required": [
    "bleed",
    "companiesTheme",
    "companyNames",
    "companySvgLogos",
    "coords",
    "cutlines",
    "cutlinesOffset",
    "font",
    "margin",
    "overrideCompanies",
    "overrideSelection",
    "paper",
    "plainMapCompanies",
    "stock",
    "theme",
    "tileCompanies",
    "tokens"
  ],
  "additionalProperties": false
}
