{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://18xx-maker.com/schemas/de/companies.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "abbrev": {
      "type": "string"
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "abbrev": {
            "type": "string"
          },
          "alias": {
            "description": "Ein zweiter Name der Gesellschaft. Die Konfiguration companyNames wählt, ob die Gesellschaftskarte und die Anteilskarten den Namen, den Alias oder beides drucken.",
            "type": "string"
          },
          "logo": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "token": {
            "$ref": "tiles.defs.json#/definitions/token"
          }
        },
        "required": ["name", "abbrev", "color"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "abbrev", "companies"],
  "additionalProperties": false
}
