{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://18xx-maker.com/schemas/de/theme.schema.json",
  "definitions": {
    "color": {
      "type": "string",
      "description": "Ein einzelner Hex- oder rgb-kodierter Farbstring",
      "pattern": "(#[0-9a-f]{3}([0-9a-f]{3})?([0-9a-f]{2})?)|(rgb\\([0-9]+,[0-9]+,[0-9]+\\))"
    },
    "themeColor": {
      "description": "Entweder eine Farbe oder eine Untergruppierung von Farben in einem bestimmten Kontext",
      "oneOf": [
        {
          "$ref": "#/definitions/color"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/themeColor"
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/themeColor"
      }
    }
  },
  "additionalProperties": false,
  "required": ["name", "colors"]
}
