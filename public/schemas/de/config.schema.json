{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://18xx-maker.com/schemas/de/config.schema.json",

  "definitions": {
    "cardSize": {
      "type": "object",
      "description": "Die Größe eines Kartentyps in Einheiten. Fehlt width oder height, wird cards.width oder cards.height verwendet.",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "description": "Die Kartenbreite in Einheiten."
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "description": "Die Kartenhöhe in Einheiten."
        }
      },
      "additionalProperties": false
    },
    "cardSizes": {
      "type": "object",
      "description": "Optionale Größe pro Kartentyp, anstelle von width und height verwendet. Fehlt width oder height, wird der Wert von oben verwendet.",
      "properties": {
        "private": { "$ref": "#/definitions/cardSize" },
        "share": { "$ref": "#/definitions/cardSize" },
        "train": { "$ref": "#/definitions/cardSize" },
        "number": { "$ref": "#/definitions/cardSize" }
      },
      "additionalProperties": false
    },
    "dieCard": {
      "type": "object",
      "description": "Die Größe der Karten eines Die-Layouts in Einheiten. Papier, Ränder, Schnittlinien und Beschnitt eines Die-Layouts sind fest.",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "description": "Die Kartenbreite in Einheiten."
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "description": "Die Kartenhöhe in Einheiten."
        },
        "sizes": { "$ref": "#/definitions/cardSizes" }
      },
      "additionalProperties": false
    },
    "font": {
      "type": "object",
      "deprecated": true,
      "description": "Die Standard-Schrifteinstellungen. Keine Druckseite verwendet sie.",
      "deprecationMessage": "Veraltet, verwende fonts.",
      "properties": {
        "size": { "type": "string" },
        "weight": { "type": "string", "enum": ["normal", "bold"] },
        "family": { "type": "string" }
      },
      "additionalProperties": { "$ref": "#/definitions/font" }
    },
    "fontRole": {
      "type": "object",
      "description": "Die Schrift einer Rolle: Familie, Größe, Stärke und Stil. Eine nicht gesetzte Einstellung wird von der Rolle body übernommen und danach vom Standard der Komponente.",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "description": "Die Schriftfamilie: der Name einer Familie aus fonts.families, eine der eingebauten display, serif und sans-serif oder eine CSS-Schriftfamilie. Systemschriften werden nicht in Exporte eingebettet."
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Die Schriftgröße in Einheiten, wie das fontSize eines Kachelelements."
        },
        "weight": {
          "description": "Die Schriftstärke: normal, bold oder eine Zahl von 1 bis 1000.",
          "oneOf": [
            { "type": "string", "enum": ["normal", "bold"] },
            { "type": "number", "minimum": 1, "maximum": 1000 }
          ]
        },
        "style": {
          "type": "string",
          "enum": ["normal", "italic", "oblique"],
          "description": "Der Schriftstil: normal, italic oder oblique."
        }
      },
      "additionalProperties": false
    },
    "fonts": {
      "type": "object",
      "description": "Die zentralen Schrifteinstellungen. Rollen (title, label, revenue, token, price, card) legen die Schrift einer Art von Text an einer Stelle fest, statt an jedem Element. Eine Schrifteinstellung eines Elements oder eines Spielfelds hat Vorrang vor der Rolle. Derzeit legt die Rolle title die Namen von Städten, Orten und Off-Board-Bereichen fest, und die Rolle card Schriftfamilie, Schriftstärke und Schriftstil des Textes der Karten der privaten Gesellschaften.",
      "properties": {
        "families": {
          "type": "object",
          "description": "Namen für Schriftfamilien, die eine Rolle als family verwenden kann. Jeder Name verweist auf eine CSS-Schriftfamilienliste und erweitert die eingebauten display, serif und sans-serif.",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "roles": {
          "type": "object",
          "description": "Die Schriften nach Rolle. Die Rolle body ist die Basis, von der alle anderen Rollen erben.",
          "properties": {
            "body": { "$ref": "#/definitions/fontRole" },
            "title": { "$ref": "#/definitions/fontRole" },
            "label": { "$ref": "#/definitions/fontRole" },
            "revenue": { "$ref": "#/definitions/fontRole" },
            "token": { "$ref": "#/definitions/fontRole" },
            "price": { "$ref": "#/definitions/fontRole" },
            "card": { "$ref": "#/definitions/fontRole" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dimension": {
      "type": "integer",
      "minimum": 1
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": { "$ref": "#/definitions/dimension" },
        "height": { "$ref": "#/definitions/dimension" }
      },
      "required": ["width", "height"]
    },
    "margins": {
      "$ref": "#/definitions/dimension"
    },
    "pins": {
      "type": "object",
      "properties": {
        "innerRadius": { "type": "number", "minimum": 0 },
        "outerRadius": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "x1": { "type": "number", "minimum": 0 },
        "x2": { "type": "number", "minimum": 0 }
      },
      "required": ["innerRadius", "outerRadius", "y", "x1", "x2"],
      "additionalProperties": false
    }
  },

  "type": "object",
  "properties": {
    "theme": { "type": "string" },
    "companiesTheme": { "type": "string" },
    "companyNames": {
      "type": "string",
      "enum": ["name", "alias", "both"],
      "description": "Was die Gesellschaftskarten und Anteilskarten als Namen einer Gesellschaft drucken. name ist der Name, alias ist der Alias der Gesellschaft (der Name, wenn sie keinen hat), both ist der Name mit dem Alias darunter."
    },
    "allowGameConfig": {
      "type": "boolean",
      "description": "Erlaubt einer Spieldatei, die Konfiguration zu ändern. Wenn aktiv, wird die Konfiguration des Spiels (der Schlüssel config einer Spieldatei) über deine Einstellungen, die URL und die Standardwerte der App gelegt. Wenn aus, wird sie ignoriert. Spiele können diese Einstellung nicht setzen. Exporte und die Kommandozeile verwenden sie genauso."
    },
    "printScale": {
      "type": "number",
      "minimum": 50,
      "maximum": 200,
      "description": "Skaliert alles, was gedruckt wird, in Prozent, um einen Drucker auszugleichen, der zu groß oder zu klein druckt. 100 ist die echte Größe. Papierformat und Ränder bleiben gleich, daher ändert sich der Inhalt einer Seite. Es ist eine Einstellung des Nutzers, eine Spieldatei kann sie nicht setzen, und Exporte ignorieren sie."
    },
    "paper": {
      "allOf": [
        {
          "$ref": "#/definitions/dimensions"
        },
        {
          "type": "object",
          "properties": {
            "margins": { "$ref": "#/definitions/margins" }
          },
          "required": ["margins"]
        }
      ]
    },
    "currency": {
      "type": "object",
      "properties": {
        "bank": { "type": "boolean" },
        "border": { "type": "boolean" },
        "capital": { "type": "boolean" },
        "market": { "type": "boolean" },
        "offboard": { "type": "boolean" },
        "par": { "type": "boolean" },
        "private": { "type": "boolean" },
        "revenue": { "type": "boolean" },
        "share": { "type": "boolean" },
        "terrain": { "type": "boolean" },
        "token": { "type": "boolean" },
        "train": { "type": "boolean" },
        "treasury": { "type": "boolean" },
        "value": { "type": "boolean" }
      },
      "required": [
        "bank",
        "border",
        "capital",
        "market",
        "offboard",
        "par",
        "private",
        "revenue",
        "terrain",
        "token",
        "train",
        "value"
      ],
      "additionalProperties": false
    },
    "stock": {
      "type": "object",
      "properties": {
        "cell": { "$ref": "#/definitions/dimensions" },
        "value": { "type": "string", "enum": ["top", "bottom"] },
        "arrows": { "type": "string", "enum": ["top", "middle", "bottom"] },
        "column": { "type": "number" },
        "diag": { "type": "number" },
        "par": { "type": "number" },
        "display": {
          "type": "object",
          "properties": {
            "legend": { "type": "boolean" },
            "par": { "type": "boolean" },
            "roundTracker": { "type": "boolean" },
            "movement": { "type": "boolean" }
          },
          "required": ["legend", "par", "roundTracker", "movement"],
          "additionalProperties": false
        }
      },
      "required": ["cell", "value", "column", "diag", "par"],
      "additionalProperties": false
    },
    "cutlines": { "type": "number", "minimum": 0 },
    "cutlinesOffset": { "type": "number", "minimum": 0 },
    "bleed": { "type": "number", "minimum": 0 },
    "margin": { "type": "number", "minimum": 0 },
    "export": {
      "type": "object",
      "properties": {
        "allLayouts": { "type": "boolean" }
      }
    },
    "cards": {
      "type": "object",
      "properties": {
        "shareStyle": {
          "type": "string",
          "enum": ["center", "left", "gmt"]
        },
        "layout": {
          "type": "string",
          "enum": ["free", "miniEuroDie", "dtgDie"]
        },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "cutlines": { "type": "number", "minimum": 0 },
        "bleed": { "type": "number", "minimum": 0 },
        "dtgPadding": { "type": "number", "minimum": 0 },
        "padding": { "type": "number", "minimum": 0 },
        "border": { "type": "number", "minimum": 0 },
        "blackBand": { "type": "boolean" },
        "sizes": {
          "$ref": "#/definitions/cardSizes",
          "description": "Optionale Größe pro Kartentyp, anstelle von width und height verwendet. Fehlt width oder height, wird der Wert von oben verwendet. Wird von den Die-Layouts ignoriert, die die Größen von cards.dice verwenden."
        },
        "dice": {
          "type": "object",
          "description": "Die Kartengrößen der Die-Layouts, die width, height und sizes von oben ignorieren.",
          "properties": {
            "miniEuroDie": { "$ref": "#/definitions/dieCard" },
            "dtgDie": { "$ref": "#/definitions/dieCard" }
          },
          "additionalProperties": false
        },
        "showPins": {
          "type": "boolean",
          "description": "Zeichnet die Pin-Markierungen auch bei freien Layouts. Feste Layouts (Die-Layouts) zeichnen sie immer. Freie Layouts reservieren keinen Platz für Pins, passe daher die Positionen der Pins oder die Ränder an, damit sie vom Inhalt frei bleiben."
        },
        "duplex": {
          "type": "string",
          "enum": ["off", "separate", "long"],
          "description": "Druckt die Rückseiten der Zugkarten. off druckt keine Rückseiten, separate druckt erst alle Vorderseiten und dann alle Rückseiten in derselben Reihenfolge (zum Wenden der Bögen von Hand), long druckt nach jedem Bogen mit Vorderseiten einen Bogen mit Rückseiten, gespiegelt für einen Drucker, der an der langen Kante wendet. Braucht das freie Kartenlayout, die Die-Layouts ignorieren es."
        },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": [
        "shareStyle",
        "layout",
        "width",
        "height",
        "cutlines",
        "bleed",
        "dtgPadding",
        "blackBand",
        "pins"
      ],
      "additionalProperties": false
    },
    "privates": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["small", "big"] }
      },
      "additionalProperties": false,
      "required": ["style"]
    },
    "trains": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["color", "number"] },
        "images": { "type": "boolean" }
      },
      "additionalProperties": false,
      "required": ["style", "images"]
    },
    "charters": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "enum": ["carth", "color"]
        },
        "layout": {
          "type": "string",
          "enum": ["free", "3x1", "3x2", "3x1minors"]
        },
        "cutlines": { "type": "number", "minimum": 0 },
        "bleed": { "type": "number", "minimum": 0 },
        "border": { "type": "number", "minimum": 0 },
        "halfWidth": { "type": "boolean" },
        "halfWidthMinors": { "type": "boolean" },
        "smallerMinors": { "type": "boolean" },
        "blackBand": { "type": "boolean" },
        "showPhaseChart": { "type": "boolean" },
        "showTurnOrder": { "type": "boolean" },
        "showMinorTurnOrder": { "type": "boolean" },
        "trainCards": { "type": "string", "enum": ["charter", "cards"] },
        "trainCardBorder": { "type": "boolean" },
        "trainCardRound": { "type": "boolean" },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": ["style", "halfWidth", "cutlines", "border", "blackBand"],
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["free", "gsp"]
        },
        "reverseMarketTokens": {
          "type": "string",
          "enum": ["none", "one", "all"]
        },
        "marketTokenSize": { "type": "number", "minimum": 1 },
        "stationTokenSize": { "type": "number", "minimum": 1 },
        "generalTokenSize": { "type": "number", "minimum": 1 },
        "bleed": { "type": "boolean" }
      },
      "additionalProperties": false,
      "required": ["layout", "marketTokenSize", "stationTokenSize", "bleed"]
    },
    "coords": {
      "type": "string",
      "enum": ["outside", "inside", "edge", "none"]
    },
    "tiles": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["right", "left", "none"]
        },
        "colorblind": { "type": "boolean" },
        "layout": {
          "type": "string",
          "enum": ["offset", "individual", "die", "smallDie"]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mapWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gaps": { "type": "boolean" },
        "cutBorder": {
          "type": "boolean",
          "description": "Zeichnet eine dünne schwarze Kontur in der exakten Schnittgröße um jedes Plättchen auf dem Plättchenbogen, damit die Plättchen von Hand ausgeschnitten werden können."
        },
        "showPins": {
          "type": "boolean",
          "description": "Zeichnet die Pin-Markierungen auch bei freien Layouts. Feste Layouts (Die-Layouts) zeichnen sie immer. Freie Layouts reservieren keinen Platz für Pins, passe daher die Positionen der Pins oder die Ränder an, damit sie vom Inhalt frei bleiben."
        },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": ["layout", "width", "mapWidth", "gaps"],
      "additionalProperties": false
    },
    "companySvgLogos": {
      "type": "string",
      "enum": ["none", "original", "match", "main"]
    },
    "overrideCompanies": {
      "type": "string",
      "enum": [
        "none",
        "languages",
        "lotr",
        "dev",
        "webdev",
        "owl",
        "1830",
        "1830-Mayfair"
      ]
    },
    "overrideSelection": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "maps": {
      "type": "object",
      "required": ["market", "players", "roundTracker", "movement"],
      "additionalProperties": false,
      "properties": {
        "market": { "type": "boolean" },
        "players": { "type": "boolean" },
        "roundTracker": { "type": "boolean" },
        "movement": { "type": "boolean" }
      }
    },
    "plainMapCompanies": { "type": "boolean" },
    "tileCompanies": { "type": "boolean" },
    "straightCityNames": { "type": "boolean" },
    "font": { "$ref": "#/definitions/font" },
    "fonts": { "$ref": "#/definitions/fonts" }
  },
  "required": [
    "bleed",
    "companiesTheme",
    "companyNames",
    "companySvgLogos",
    "coords",
    "cutlines",
    "cutlinesOffset",
    "font",
    "margin",
    "overrideCompanies",
    "overrideSelection",
    "paper",
    "plainMapCompanies",
    "stock",
    "theme",
    "tileCompanies",
    "tokens"
  ],
  "additionalProperties": false
}
