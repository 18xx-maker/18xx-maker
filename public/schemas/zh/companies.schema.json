{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://18xx-maker.com/schemas/zh/companies.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "abbrev": {
      "type": "string"
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "abbrev": {
            "type": "string"
          },
          "alias": {
            "description": "公司的第二个名称。companyNames 配置决定公司执照和股份卡打印名称、别名还是两者。",
            "type": "string"
          },
          "logo": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "token": {
            "$ref": "tiles.defs.json#/definitions/token"
          }
        },
        "required": ["name", "abbrev", "color"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "abbrev", "companies"],
  "additionalProperties": false
}
