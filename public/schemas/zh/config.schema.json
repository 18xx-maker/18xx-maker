{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://18xx-maker.com/schemas/zh/config.schema.json",

  "definitions": {
    "cardSize": {
      "type": "object",
      "description": "一种卡牌的尺寸,以单位计。缺少 width 或 height 时使用 cards.width 或 cards.height。",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "description": "卡牌宽度,以单位计。"
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "description": "卡牌高度,以单位计。"
        }
      },
      "additionalProperties": false
    },
    "cardSizes": {
      "type": "object",
      "description": "每种卡牌的可选尺寸,代替 width 和 height 使用。缺少 width 或 height 时使用上面的值。",
      "properties": {
        "private": { "$ref": "#/definitions/cardSize" },
        "share": { "$ref": "#/definitions/cardSize" },
        "train": { "$ref": "#/definitions/cardSize" },
        "number": { "$ref": "#/definitions/cardSize" }
      },
      "additionalProperties": false
    },
    "dieCard": {
      "type": "object",
      "description": "模切布局中卡牌的尺寸,以单位计。模切布局的纸张、页边距、裁切线和出血是固定的。",
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "description": "卡牌宽度,以单位计。"
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "description": "卡牌高度,以单位计。"
        },
        "sizes": { "$ref": "#/definitions/cardSizes" }
      },
      "additionalProperties": false
    },
    "font": {
      "type": "object",
      "properties": {
        "size": { "type": "string" },
        "weight": { "type": "string", "enum": ["normal", "bold"] },
        "family": { "type": "string" }
      },
      "additionalProperties": { "$ref": "#/definitions/font" }
    },
    "dimension": {
      "type": "integer",
      "minimum": 1
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": { "$ref": "#/definitions/dimension" },
        "height": { "$ref": "#/definitions/dimension" }
      },
      "required": ["width", "height"]
    },
    "margins": {
      "$ref": "#/definitions/dimension"
    },
    "pins": {
      "type": "object",
      "properties": {
        "innerRadius": { "type": "number", "minimum": 0 },
        "outerRadius": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "x1": { "type": "number", "minimum": 0 },
        "x2": { "type": "number", "minimum": 0 }
      },
      "required": ["innerRadius", "outerRadius", "y", "x1", "x2"],
      "additionalProperties": false
    }
  },

  "type": "object",
  "properties": {
    "theme": { "type": "string" },
    "companiesTheme": { "type": "string" },
    "companyNames": {
      "type": "string",
      "enum": ["name", "alias", "both"],
      "description": "公司执照和股份卡将什么打印为公司的名称。name 是名称,alias 是公司的别名(没有别名时为名称),both 是名称加其下方的别名。"
    },
    "allowGameConfig": {
      "type": "boolean",
      "description": "允许游戏文件更改配置。开启后,游戏的配置(游戏文件的 config 键)会覆盖您的设置、URL 和应用默认值;关闭时将被忽略。游戏无法设置此项。导出和命令行的处理方式相同。"
    },
    "printScale": {
      "type": "number",
      "minimum": 50,
      "maximum": 200,
      "description": "按百分比缩放所有打印内容,用于校正打印偏大或偏小的打印机。100 为实际尺寸。纸张大小和页边距不变,因此页面内容会改变。这是用户的设置,游戏文件无法设置,导出会忽略它。"
    },
    "paper": {
      "allOf": [
        {
          "$ref": "#/definitions/dimensions"
        },
        {
          "type": "object",
          "properties": {
            "margins": { "$ref": "#/definitions/margins" }
          },
          "required": ["margins"]
        }
      ]
    },
    "currency": {
      "type": "object",
      "properties": {
        "bank": { "type": "boolean" },
        "border": { "type": "boolean" },
        "capital": { "type": "boolean" },
        "market": { "type": "boolean" },
        "offboard": { "type": "boolean" },
        "par": { "type": "boolean" },
        "private": { "type": "boolean" },
        "revenue": { "type": "boolean" },
        "share": { "type": "boolean" },
        "terrain": { "type": "boolean" },
        "token": { "type": "boolean" },
        "train": { "type": "boolean" },
        "treasury": { "type": "boolean" },
        "value": { "type": "boolean" }
      },
      "required": [
        "bank",
        "border",
        "capital",
        "market",
        "offboard",
        "par",
        "private",
        "revenue",
        "terrain",
        "token",
        "train",
        "value"
      ],
      "additionalProperties": false
    },
    "stock": {
      "type": "object",
      "properties": {
        "cell": { "$ref": "#/definitions/dimensions" },
        "value": { "type": "string", "enum": ["top", "bottom"] },
        "arrows": { "type": "string", "enum": ["top", "middle", "bottom"] },
        "column": { "type": "number" },
        "diag": { "type": "number" },
        "par": { "type": "number" },
        "display": {
          "type": "object",
          "properties": {
            "legend": { "type": "boolean" },
            "par": { "type": "boolean" },
            "roundTracker": { "type": "boolean" },
            "movement": { "type": "boolean" }
          },
          "required": ["legend", "par", "roundTracker", "movement"],
          "additionalProperties": false
        }
      },
      "required": ["cell", "value", "column", "diag", "par"],
      "additionalProperties": false
    },
    "cutlines": { "type": "number", "minimum": 0 },
    "cutlinesOffset": { "type": "number", "minimum": 0 },
    "bleed": { "type": "number", "minimum": 0 },
    "margin": { "type": "number", "minimum": 0 },
    "export": {
      "type": "object",
      "properties": {
        "allLayouts": { "type": "boolean" }
      }
    },
    "cards": {
      "type": "object",
      "properties": {
        "shareStyle": {
          "type": "string",
          "enum": ["center", "left", "gmt"]
        },
        "layout": {
          "type": "string",
          "enum": ["free", "miniEuroDie", "dtgDie"]
        },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "cutlines": { "type": "number", "minimum": 0 },
        "bleed": { "type": "number", "minimum": 0 },
        "dtgPadding": { "type": "number", "minimum": 0 },
        "padding": { "type": "number", "minimum": 0 },
        "border": { "type": "number", "minimum": 0 },
        "blackBand": { "type": "boolean" },
        "sizes": {
          "$ref": "#/definitions/cardSizes",
          "description": "每种卡牌的可选尺寸,代替 width 和 height 使用。缺少 width 或 height 时使用上面的值。模切布局会忽略它,它们使用 cards.dice 的尺寸。"
        },
        "dice": {
          "type": "object",
          "description": "模切布局的卡牌尺寸,会忽略上面的 width、height 和 sizes。",
          "properties": {
            "miniEuroDie": { "$ref": "#/definitions/dieCard" },
            "dtgDie": { "$ref": "#/definitions/dieCard" }
          },
          "additionalProperties": false
        },
        "showPins": {
          "type": "boolean",
          "description": "在自由布局上也绘制定位针标记。固定布局(模切布局)始终绘制。自由布局不为定位针预留空间,因此请调整定位针位置或页边距,使其避开内容。"
        },
        "duplex": {
          "type": "string",
          "enum": ["off", "separate", "long"],
          "description": "打印列车卡的背面。off 不打印背面,separate 先打印所有正面再按相同顺序打印所有背面(用于手动翻页),long 在每页正面之后打印一页背面,并镜像,适用于设为长边翻转的打印机。需要自由卡牌布局,模切布局会忽略它。"
        },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": [
        "shareStyle",
        "layout",
        "width",
        "height",
        "cutlines",
        "bleed",
        "dtgPadding",
        "blackBand",
        "pins"
      ],
      "additionalProperties": false
    },
    "privates": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["small", "big"] }
      },
      "additionalProperties": false,
      "required": ["style"]
    },
    "trains": {
      "type": "object",
      "properties": {
        "style": { "type": "string", "enum": ["color", "number"] },
        "images": { "type": "boolean" }
      },
      "additionalProperties": false,
      "required": ["style", "images"]
    },
    "charters": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string",
          "enum": ["carth", "color"]
        },
        "layout": {
          "type": "string",
          "enum": ["free", "3x1", "3x2", "3x1minors"]
        },
        "cutlines": { "type": "number", "minimum": 0 },
        "bleed": { "type": "number", "minimum": 0 },
        "border": { "type": "number", "minimum": 0 },
        "halfWidth": { "type": "boolean" },
        "halfWidthMinors": { "type": "boolean" },
        "smallerMinors": { "type": "boolean" },
        "blackBand": { "type": "boolean" },
        "showPhaseChart": { "type": "boolean" },
        "showTurnOrder": { "type": "boolean" },
        "showMinorTurnOrder": { "type": "boolean" },
        "trainCards": { "type": "string", "enum": ["charter", "cards"] },
        "trainCardBorder": { "type": "boolean" },
        "trainCardRound": { "type": "boolean" },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": ["style", "halfWidth", "cutlines", "border", "blackBand"],
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["free", "gsp"]
        },
        "reverseMarketTokens": {
          "type": "string",
          "enum": ["none", "one", "all"]
        },
        "marketTokenSize": { "type": "number", "minimum": 1 },
        "stationTokenSize": { "type": "number", "minimum": 1 },
        "generalTokenSize": { "type": "number", "minimum": 1 },
        "bleed": { "type": "boolean" }
      },
      "additionalProperties": false,
      "required": ["layout", "marketTokenSize", "stationTokenSize", "bleed"]
    },
    "coords": {
      "type": "string",
      "enum": ["outside", "inside", "edge", "none"]
    },
    "tiles": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["right", "left", "none"]
        },
        "colorblind": { "type": "boolean" },
        "layout": {
          "type": "string",
          "enum": ["offset", "individual", "die", "smallDie"]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mapWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gaps": { "type": "boolean" },
        "cutBorder": {
          "type": "boolean",
          "description": "在地块页上每个地块周围按精确裁切尺寸绘制一圈细黑色轮廓,以便手工裁剪地块。"
        },
        "showPins": {
          "type": "boolean",
          "description": "在自由布局上也绘制定位针标记。固定布局(模切布局)始终绘制。自由布局不为定位针预留空间,因此请调整定位针位置或页边距,使其避开内容。"
        },
        "pins": { "$ref": "#/definitions/pins" }
      },
      "required": ["layout", "width", "mapWidth", "gaps"],
      "additionalProperties": false
    },
    "companySvgLogos": {
      "type": "string",
      "enum": ["none", "original", "match", "main"]
    },
    "overrideCompanies": {
      "type": "string",
      "enum": [
        "none",
        "languages",
        "lotr",
        "dev",
        "webdev",
        "owl",
        "1830",
        "1830-Mayfair"
      ]
    },
    "overrideSelection": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "maps": {
      "type": "object",
      "required": ["market", "players", "roundTracker", "movement"],
      "additionalProperties": false,
      "properties": {
        "market": { "type": "boolean" },
        "players": { "type": "boolean" },
        "roundTracker": { "type": "boolean" },
        "movement": { "type": "boolean" }
      }
    },
    "plainMapCompanies": { "type": "boolean" },
    "tileCompanies": { "type": "boolean" },
    "straightCityNames": { "type": "boolean" },
    "font": { "$ref": "#/definitions/font" }
  },
  "required": [
    "bleed",
    "companiesTheme",
    "companyNames",
    "companySvgLogos",
    "coords",
    "cutlines",
    "cutlinesOffset",
    "font",
    "margin",
    "overrideCompanies",
    "overrideSelection",
    "paper",
    "plainMapCompanies",
    "stock",
    "theme",
    "tileCompanies",
    "tokens"
  ],
  "additionalProperties": false
}
