{
  "name": "18xx-maker",
  "version": "1.0.0-beta.132",
  "author": "Christopher Giroir <kelsin@valefor.com>",
  "description": "18xx Prototyper",
  "type": "module",
  "homepage": "https://www.18xx-maker.com",
  "repository": "github:18xx-maker/18xx-maker",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/main/index.cjs",
  "bin": {
    "maker": "bin/maker.js"
  },
  "imports": {
    "#cli/*": "./src/cli/*.js",
    "#export/*": "./src/export/*.js",
    "#util/*": "./src/util/*.js"
  },
  "scripts": {
    "b18": "node bin/maker.js b18",
    "build": "vite build",
    "build:app": "electron-vite build",
    "build:sb": "storybook build -o dist/sb",
    "bundle": "vite-bundle-visualizer",
    "fix": "run-s pretty:fix lint:fix",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "maker": "node bin/maker.js",
    "package:app": "electron-builder build -mwl -p never",
    "pretty": "prettier -c .",
    "pretty:fix": "prettier --write .",
    "preview": "vite preview",
    "preview:app": "electron-vite preview",
    "print": "node bin/maker.js print",
    "start": "vite",
    "start:app": "electron-vite dev",
    "start:sb": "storybook dev -p 6006 --no-open",
    "svgo": "run-p svgo:icons svgo:logos",
    "svgo:icons": "svgo -f src/data/icons",
    "svgo:logos": "svgo -f src/data/logos",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:export": "playwright test -c playwright.export.config.js",
    "test:run": "vitest run",
    "docs:images": "node ./scripts/docs-images.mjs",
    "shot": "node ./scripts/shot.mjs",
    "validate": "node ./bin/maker.js validate \"src/schemas/*.schema.json\" \"src/*.json\" \"src/data/**/*.json\"",
    "validate:schemas": "node ./bin/maker.js validate \"src/schemas/*.schema.json\" \"public/schemas/**/*.json\""
  },
  "browserslist": {
    "production": [
      "defaults"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0,
        "always"
      ],
      "footer-max-line-length": [
        0,
        "always"
      ],
      "header-max-length": [
        0,
        "always"
      ]
    }
  },
  "prettier": {
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^ramda$",
      "",
      "^lucide-react$",
      "",
      "^@/components/ui",
      "",
      "^@/components",
      "",
      "^@(/.*)$",
      "^#(.*)$",
      "^[.]",
      "",
      "^@tests(/.*)$",
      "",
      "^(?!.*[.]css$)[./].*$",
      "\\.css$"
    ],
    "importOrderCaseSensitive": true
  },
  "build": {
    "appId": "com.18xx-maker.app",
    "artifactName": "18xx-maker-${version}-${os}-${arch}.${ext}",
    "electronUpdaterCompatibility": ">= 2.16",
    "productName": "18xx Maker",
    "directories": {
      "buildResources": "electron/assets",
      "output": "dist/app"
    },
    "files": [
      "!.*",
      "!AGENTS.md",
      "!bin${/*}",
      "!certificate.p12",
      "!CLAUDE.md",
      "!coverage${/*}",
      "!dist/app${/*}",
      "!dist/sb${/*}",
      "!dist/site${/*}",
      "!docker${/*}",
      "!e2e${/*}",
      "!electron${/*}",
      "!electron.vite.config.js",
      "!eslint.config.js",
      "!index.html",
      "!junit.xml",
      "!lefthook.yml",
      "!Makefile",
      "!out${/*}",
      "!playwright-report${/*}",
      "!playwright.config.js",
      "!pnpm-lock.yaml",
      "!public${/*}",
      "!release-please-config.json",
      "!render${/*}",
      "!src${/*}",
      "!stats.html",
      "!svgo.config.js",
      "!test-results${/*}",
      "!tests${/*}",
      "!vite.config.js",
      "!vitest.config.js"
    ],
    "afterSign": "electron/notarize.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "electron/assets/18xx-maker.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/assets/entitlements.mac.plist",
      "entitlementsInherit": "electron/assets/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "background": "electron/assets/background.tiff"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ],
      "icon": "electron/assets/18xx-maker.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/assets/18xx-maker.png",
      "executableName": "18xx-maker"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@replit/codemirror-emacs": "6.1.0",
    "@replit/codemirror-vim": "6.4.0",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "ramda": "^0.32.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/storybook": "^5.3.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@plausible-analytics/tracker": "^0.4.6",
    "@playwright/test": "1.62.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reduxjs/toolkit": "^2.13.0",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "axe-core": "^4.13.0",
    "browserslist": "^4.29.3",
    "browserslist-to-esbuild": "^2.1.1",
    "chalk": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "deep-object-diff": "^1.1.9",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "env-paths": "^4.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "json-schema-library": "11.6.2",
    "lefthook": "^2.1.15",
    "lucide-react": "^1.49.0",
    "npm-run-all2": "^9.0.3",
    "playwright": "1.62.0",
    "prettier": "^3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "regexparam": "^3.0.0",
    "remark-flexible-containers": "^1.5.8",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "shiki": "^4.5.0",
    "sirv": "^3.0.2",
    "storybook": "^10.6.1",
    "svgo": "^3.3.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tinycolor2": "^1.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.6",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-fast-react-svg": "^0.6.2",
    "vitest": "^5.0.3"
  }
}
